# Never run dependency lifecycle scripts (preinstall/install/postinstall) on
# `npm install` / `npm ci`. Explicit `npm run <script>` / `npm test` still work.
ignore-scripts=true
# Refuse installs on an unsupported Node instead of warning.
engine-strict=true
# Record exact versions when a dependency is added.
save-exact=true
fund=false
update-notifier=false
# Don't send this project's dependency list to the registry's audit service on every
# install. Run `npm audit` yourself when you want that check.
audit=false
